{
  "name": "textile-marketplace",
  "version": "1.0.0",
  "description": "B2B textile marketplace connecting suppliers with buyers",
  "private": true,
  "scripts": {
    "install:all": "npm install && cd server && npm install && cd ../client && npm install",
    "dev:server": "cd server && npm run dev",
